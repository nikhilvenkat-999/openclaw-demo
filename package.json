{
  "name": "openclaw-demo",
  "version": "1.0.0",
  "description": "OpenClaw Demo Project - AI Agent with Ollama (Free, No API Keys)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
